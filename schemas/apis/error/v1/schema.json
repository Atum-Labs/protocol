{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "file://apis/error/v1/schema.json",
  "title": "AtumError",
  "description": "Standardized error structure for all Atum services",
  "type": "object",
  "required": ["code", "message", "timestamp", "request_id"],
  "properties": {
    "code": {
      "type": "string",
      "description": "Machine-readable error code in SCREAMING_SNAKE_CASE",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "examples": [
        "TX_REVERTED",
        "IDEMPOTENCY_TERMS_MISMATCH",
        "CHAIN_NOT_SUPPORTED",
        "INVALID_REQUEST",
        "QUOTE_DEADLINE_EXPIRED",
        "COUNTERPARTY_TIMEOUT",
        "WALLET_KMS_ERROR"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the error occurred"
    },
    "request_id": {
      "type": "string",
      "description": "Distributed request ID for debugging across services"
    },
    "payment_id": {
      "type": "string",
      "description": "The payment this error was raised against. Absent when the error is not about a specific payment."
    },
    "message": {
      "type": "string",
      "description": "Human-readable error message",
      "maxLength": 500
    },
    "domain": {
      "type": "string",
      "description": "Service domain where the error originated",
      "enum": [
        "PAYMENT_GATEWAY",
        "SETTLER_GATEWAY",
        "SETTLER_AGENT",
        "WALLET_ORCHESTRATION",
        "VERIFICATION_SERVICE",
        "BLOCKCHAIN",
        "EXTERNAL_SERVICE",
        "IDENTITY_SIGNING",
        "AUTHORIZATION_SERVICE",
        "COUNTERPARTY_GATEWAY"
      ]
    },
    "details": {
      "type": "object",
      "description": "Additional context-specific error details",
      "additionalProperties": true
    },
    "blockchain_context": {
      "$ref": "#/$defs/BlockchainContext"
    }
  },
  "$defs": {
    "BlockchainContext": {
      "type": "object",
      "description": "Blockchain-specific error context",
      "properties": {
        "chain_id": {
          "type": "string",
          "description": "CAIP-2 chain identifier",
          "pattern": "^[a-z0-9]+:[a-zA-Z0-9_-]+$"
        },
        "transaction_hash": {
          "type": "string",
          "description": "Failed transaction hash",
          "pattern": "^(0x[a-fA-F0-9]{64}|[1-9A-HJ-NP-Za-km-z]{32,88})$"
        },
        "block_number": {
          "type": "integer",
          "description": "Block number where error occurred"
        },
        "contract_address": {
          "type": "string",
          "description": "Contract that caused the error",
          "pattern": "^(0x[a-fA-F0-9]{40}|[1-9A-HJ-NP-Za-km-z]{32,44}|[GC][A-Z2-7]{55})$"
        },
        "revert_reason": {
          "type": "string",
          "description": "Smart contract revert reason"
        },
        "gas_used": {
          "type": "string",
          "description": "Gas consumed before failure"
        },
        "estimated_gas_needed": {
          "type": "string",
          "description": "Estimated gas needed for success"
        }
      }
    }
  }
}
