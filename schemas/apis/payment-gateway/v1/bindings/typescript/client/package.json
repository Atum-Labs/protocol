{
  "name": "@atum-labs/payment-gateway-client",
  "version": "6.0.0",
  "description": "TypeScript client for Atum Payment Gateway API",
  "author": "Atum Labs, Inc.",
  "homepage": "https://github.com/Atum-Labs/protocol/tree/main/schemas/apis/payment-gateway/v1/bindings/typescript/client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atum-Labs/protocol.git",
    "directory": "schemas/apis/payment-gateway/v1/bindings/typescript/client"
  },
  "bugs": {
    "url": "https://github.com/Atum-Labs/protocol/issues"
  },
  "keywords": [
    "atum",
    "payment-gateway",
    "cross-chain",
    "stablecoin",
    "usdc",
    "permit2",
    "caip-19",
    "evm",
    "solana",
    "tron",
    "stellar",
    "client",
    "sdk"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./signing": {
      "types": "./dist/signing.d.ts",
      "default": "./dist/signing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "send-payment": "./dist/cli/send-payment.js",
    "request-quote": "./dist/cli/request-quote.js",
    "quote-status": "./dist/cli/quote-status.js",
    "payment-status": "./dist/cli/payment-status.js",
    "approve-permit2": "./dist/cli/approve-permit2.js",
    "award-quote": "./dist/cli/award-quote.js"
  },
  "scripts": {
    "generate": "openapi-ts --input ../../../openapi.yaml --output \"${PGC_GEN_OUT:-./src/generated}\" --client axios --name PaymentGatewayClient --useOptions",
    "lint": "eslint . --max-warnings 0",
    "prebuild:deps": "node -e \"if(!require('fs').existsSync('../../../../../../../pnpm-workspace.yaml')){console.error('protocol workspace not found at ../../../../../../../pnpm-workspace.yaml. Is this checked out inside the protocol monorepo?');process.exit(1)}\"",
    "build:deps": "pnpm --filter \"@atum-labs/payment-gateway-client^...\" run build",
    "build": "tsup && chmod +x dist/cli/*.js && node scripts/stamp-entry-headers.mjs",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "pnpm run typecheck:tests && jest",
    "clean": "rm -rf dist && pnpm --filter \"@atum-labs/payment-gateway-client^...\" run clean",
    "check:publishable": "node scripts/check-publishable.mjs",
    "gen:notices": "node scripts/gen-third-party-notices.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm run check:publishable",
    "prebuild": "node scripts/gen-pre-context.mjs",
    "check:pre-context": "node scripts/gen-pre-context.mjs --check"
  },
  "dependencies": {
    "@solana/web3.js": "^1.91.0",
    "axios": "1.20.0",
    "bs58": "^6.0.0",
    "commander": "^12.0.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.11.0",
    "jsonld": "8.3.3",
    "rdf-canonize": "3.4.0",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@atum-labs/chain-address": "workspace:*",
    "@atum-labs/evm-escrow-encoding": "workspace:*",
    "@atum-labs/km-core": "workspace:*",
    "@atum-labs/ld-signing": "workspace:*",
    "@atum-labs/payment-request-ld-signing": "workspace:*",
    "@atum-labs/payment-request-sender-auth": "workspace:*",
    "@atum-labs/payment-request-token-approval": "workspace:*",
    "@atum-labs/publish-guard": "workspace:*",
    "@atum-labs/schema-declarations": "workspace:*",
    "@atum-labs/solana-escrow-encoding": "workspace:*",
    "@atum-labs/stellar-escrow-encoding": "workspace:*",
    "@atum-labs/turnkey-signer": "workspace:*",
    "@atum-labs/tvm-escrow-encoding": "workspace:*",
    "@hey-api/openapi-ts": "^0.45.1",
    "@stellar/stellar-sdk": "17.3.0",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jest": "^29.7.0",
    "tronweb": "^6.0.0",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "uuid": "^11.1.1"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "docs/**",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt",
    "signing.js",
    "signing.d.ts"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "tronweb": "^6.0.0",
    "@stellar/stellar-sdk": "^17.3.0"
  },
  "peerDependenciesMeta": {
    "tronweb": {
      "optional": true
    },
    "@stellar/stellar-sdk": {
      "optional": true
    }
  }
}
