# Configuration for the command-line tools: send-payment, request-quote,
# quote-status, payment-status.
#
#   cp .env.example .env
#
# The tools read .env from the directory you run them in. Where a variable has a
# matching command-line flag, the flag takes precedence, then a value already
# exported in your shell, then this file, then the built-in default.
#
# .env and .env.* are git-ignored, so a filled-in copy stays out of version
# control. Never commit real keys.
#
# Using the SDK rather than the command-line tools? This file does not apply: the
# SDK does not read it. Pass configuration as arguments instead, for example
# `new PaymentGatewayClient({ BASE })` and `createSenderSigner(...)`. GATEWAY_URL
# is the one variable the client also reads from the environment, and placing it
# there is your application's responsibility.

# Required by `send-payment` with the default `--provider raw`.
# The depositor's signing key. If unset, the CLI prompts for it securely.
#   - EVM / Tron: 64-hex private key, with or without the 0x prefix
#   - Solana:     base58-encoded secret key
# Keep this secret — never commit a real key.
PRIVATE_KEY=

# Required by `send-payment --provider turnkey`, which signs through a Turnkey
# wallet instead of a local private key. The <sender> argument is verified against
# the wallet's address for the source chain. Keep the API private key secret.
TURNKEY_ORGANIZATION_ID=
TURNKEY_WALLET_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Optional. Payment gateway base URL, used when no `--gateway` flag is passed.
#   Testnet (default): https://payment-gw.production-testnet.atum.xyz
#   Mainnet:           https://payment-gw.production-mainnet.atum.xyz
GATEWAY_URL=https://payment-gw.production-testnet.atum.xyz

# Optional, Solana source only. The RPC endpoint used to read the cluster clock
# that grounds a Solana deposit's issued_at, used when no `--solana-rpc-url` flag
# is passed. Falls back to the public endpoint for the cluster, which is rate
# limited; set your own to avoid it.
SOLANA_RPC_URL=
