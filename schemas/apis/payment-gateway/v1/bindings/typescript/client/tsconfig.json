{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // ES2022.Error only, for the `cause` option on the Error constructor. Node 18 (the
    // engines floor) supports it at runtime; this adds the typing without pulling in the
    // rest of ES2022.
    "lib": ["ES2020", "ES2022.Error"],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
