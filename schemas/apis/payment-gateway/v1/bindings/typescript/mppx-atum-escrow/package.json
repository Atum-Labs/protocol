{
  "name": "@atum-labs/mppx-atum-escrow",
  "version": "0.7.1",
  "description": "Atum cross-chain escrow payment method for the Machine Payments Protocol (MPP).",
  "author": "Atum Labs, Inc.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Atum-Labs/protocol/tree/main/schemas/apis/payment-gateway/v1/bindings/typescript/mppx-atum-escrow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atum-Labs/protocol.git",
    "directory": "schemas/apis/payment-gateway/v1/bindings/typescript/mppx-atum-escrow"
  },
  "bugs": {
    "url": "https://github.com/Atum-Labs/protocol/issues"
  },
  "keywords": [
    "atum",
    "mpp",
    "machine-payments-protocol",
    "payment-method",
    "cross-chain",
    "stablecoin",
    "escrow",
    "permit2"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.txt"
  ],
  "scripts": {
    "prebuild:deps": "node -e \"if(!require('fs').existsSync('../../../../../../../pnpm-workspace.yaml')){console.error('protocol workspace not found at ../../../../../../../pnpm-workspace.yaml. Is this checked out inside the protocol monorepo?');process.exit(1)}\"",
    "build:deps": "pnpm --filter \"@atum-labs/mppx-atum-escrow^...\" run build",
    "build": "tsup && node scripts/stamp-entry-headers.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "pnpm run typecheck:tests && vitest run",
    "clean": "rm -rf dist && pnpm --filter \"@atum-labs/mppx-atum-escrow^...\" run clean",
    "check:publishable": "node scripts/check-publishable.mjs",
    "gen:notices": "node scripts/gen-third-party-notices.mjs",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run build && pnpm run check:publishable"
  },
  "dependencies": {
    "@solana/web3.js": "^1.91.0",
    "bs58": "^6.0.0",
    "ethers": "^6.13.0",
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "mppx": ">=0.8.12 <0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@atum-labs/atum-escrow": "workspace:*",
    "@atum-labs/evm-escrow-encoding": "workspace:*",
    "@atum-labs/payment-gateway-client": "workspace:*",
    "@atum-labs/payment-request-sender-auth": "workspace:*",
    "@atum-labs/payment-request-token-approval": "workspace:*",
    "@atum-labs/publish-guard": "workspace:*",
    "@atum-labs/schema-declarations": "workspace:*",
    "@atum-labs/solana-escrow-encoding": "workspace:*",
    "@atum-labs/tvm-escrow-encoding": "workspace:*",
    "@types/node": "^20.0.0",
    "mppx": "^0.8.12",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
