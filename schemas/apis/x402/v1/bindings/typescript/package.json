{
  "name": "@atum-labs/atum-escrow",
  "version": "1.0.0",
  "description": "TypeScript types for the atum-escrow x402 scheme (challenge extra + request + credential payload)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate:extra": "json2ts ../../extra/schema.json > src/extra.ts",
    "generate:payload": "json2ts ../../payload/schema.json > src/payload.ts",
    "generate:request": "cd ../../request && json2ts schema.json > ../bindings/typescript/src/request.ts",
    "generate": "npm run generate:extra && npm run generate:payload && npm run generate:request",
    "clean": "rm -rf dist",
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run"
  },
  "keywords": [
    "atum",
    "atum-escrow",
    "x402",
    "payment-scheme",
    "typescript",
    "schema"
  ],
  "author": "Atum Labs",
  "license": "Apache-2.0",
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@types/node": "^20.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^13.1.2",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
