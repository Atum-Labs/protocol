# Default target
all: generate build

# Install dependencies (alias for install-tools for consistency)
deps:
	@echo "Installing API dependencies..."
	@echo "Installing oapi-codegen..."
	@go install github.com/oapi-codegen/oapi-codegen/v2/cmd/oapi-codegen@v2.5.1
	@echo "Installing go-jsonschema..."
	@go install github.com/atombender/go-jsonschema@v0.20.0
	@echo "✅ API dependencies installed (TypeScript workspace deps come from 'pnpm install' at the repo root)"

# Install required tools (kept for backward compatibility)
install-tools: deps

# Check if required tools are installed
check-tools:
	@echo "Checking for required tools..."
	@which oapi-codegen > /dev/null || (echo "✗ oapi-codegen not found. Run 'make install-tools'" && exit 1)
	@which go-jsonschema > /dev/null || (echo "✗ go-jsonschema not found. Run 'make install-tools'" && exit 1)
	@pnpm exec sh -c "command -v openapi-typescript" > /dev/null 2>&1 || (echo "✗ openapi-typescript not found. Run 'pnpm install' in repo root" && exit 1)
	@pnpm exec sh -c "command -v json2ts" > /dev/null 2>&1 || (echo "✗ json-schema-to-typescript not found. Run 'pnpm install' in repo root" && exit 1)
	@echo "✅ All required tools found"

# Generate all API bindings
generate: deps generate-fulfillment-confirmation generate-error generate-decline generate-veri-fill generate-payment-gateway generate-auth generate-counterparty-gateway-registration generate-counterparty-gateway-webhook generate-wallet-orch generate-x402
	@echo "✅ All API bindings generated"

# Generate ONLY the deterministic, version-pinned Go artifacts:
#   * oapi-codegen@v2.5.1 Go bindings (types/client/gin-server) for every API
#   * the go-jsonschema@v0.20.0 Go types for the JSON-Schema APIs (error,
#     fulfillment-confirmation)
#   * the payment-gateway embed/go/openapi.yaml + openapi.go copy
# It does NOT run @hey-api/openapi-ts (VeriFillClient.ts, *.gen.ts, core/**,
# ...) or openapi-typescript — those tools are unpinned
# and out of scope. This target is Go-only (no Node) and is what the
# `check-api-bindings` drift guard in schemas/Makefile regenerates from.
generate-go-bindings: pin-auth-go-module init-fulfillment-confirmation-go-module init-payment-gateway-go-module init-veri-fill-go-module init-counterparty-gateway-registration-go-module init-counterparty-gateway-webhook-go-module
	@echo "Generating deterministic Go API bindings (oapi-codegen + go-jsonschema + embed)..."
	@# --- veri-fill (oapi-codegen; generated/ subdir) ---
	@mkdir -p veri-fill/v1/bindings/go/generated
	@oapi-codegen -package generated -generate types -o veri-fill/v1/bindings/go/generated/types.go veri-fill/v1/openapi.yaml
	@oapi-codegen -package generated -generate client -response-type-suffix "HTTPResponse" -o veri-fill/v1/bindings/go/generated/client.go veri-fill/v1/openapi.yaml
	@oapi-codegen -package generated -generate gin-server -o veri-fill/v1/bindings/go/generated/server.go veri-fill/v1/openapi.yaml
	@cd veri-fill/v1/bindings/go && go mod tidy
	@# --- payment-gateway (oapi-codegen bindings + embed copy) ---
	@oapi-codegen -package paymentgateway -generate types -o payment-gateway/v1/bindings/go/types.go payment-gateway/v1/openapi.yaml
	@oapi-codegen -package paymentgateway -generate client -response-type-suffix "HTTPResponse" -o payment-gateway/v1/bindings/go/client.go payment-gateway/v1/openapi.yaml
	@oapi-codegen -package paymentgateway -generate gin-server -o payment-gateway/v1/bindings/go/server.go payment-gateway/v1/openapi.yaml
	@mkdir -p payment-gateway/v1/embed/go
	@cp payment-gateway/v1/openapi.yaml payment-gateway/v1/embed/go/openapi.yaml
	@echo "// Code generated by schemas/apis/Makefile. DO NOT EDIT." > payment-gateway/v1/embed/go/openapi.go
	@echo "" >> payment-gateway/v1/embed/go/openapi.go
	@echo "// Package embed provides the embedded OpenAPI specification for the Payment Gateway API." >> payment-gateway/v1/embed/go/openapi.go
	@echo "// This package is separate from the generated bindings to maintain clean architectural boundaries." >> payment-gateway/v1/embed/go/openapi.go
	@echo "// The OpenAPI spec is embedded directly from the source to ensure types and documentation" >> payment-gateway/v1/embed/go/openapi.go
	@echo "// are always synchronized." >> payment-gateway/v1/embed/go/openapi.go
	@echo "package embed" >> payment-gateway/v1/embed/go/openapi.go
	@echo "" >> payment-gateway/v1/embed/go/openapi.go
	@echo "import (" >> payment-gateway/v1/embed/go/openapi.go
	@echo "	_ \"embed\"" >> payment-gateway/v1/embed/go/openapi.go
	@echo ")" >> payment-gateway/v1/embed/go/openapi.go
	@echo "" >> payment-gateway/v1/embed/go/openapi.go
	@echo "// OpenAPISpec contains the embedded OpenAPI specification for the Payment Gateway API." >> payment-gateway/v1/embed/go/openapi.go
	@echo "// This ensures that the API documentation always matches the generated types." >> payment-gateway/v1/embed/go/openapi.go
	@echo "//" >> payment-gateway/v1/embed/go/openapi.go
	@echo "//go:embed openapi.yaml" >> payment-gateway/v1/embed/go/openapi.go
	@echo "var OpenAPISpec []byte" >> payment-gateway/v1/embed/go/openapi.go
	@cd payment-gateway/v1/bindings/go && go mod tidy
	@# --- auth (oapi-codegen) ---
	@oapi-codegen -package auth -generate types -o auth/v1/bindings/go/types.go auth/v1/openapi.yaml
	@oapi-codegen -package auth -generate client -response-type-suffix "HTTPResponse" -o auth/v1/bindings/go/client.go auth/v1/openapi.yaml
	@oapi-codegen -package auth -generate gin-server -o auth/v1/bindings/go/server.go auth/v1/openapi.yaml
	@cd auth/v1/bindings/go && go mod tidy
	@# --- counterparty-gateway/registration (oapi-codegen) ---
	@oapi-codegen -package registration -generate types -o counterparty-gateway/v1/registration/bindings/go/types.go counterparty-gateway/v1/registration/openapi.yaml
	@oapi-codegen -package registration -generate client -response-type-suffix "HTTPResponse" -o counterparty-gateway/v1/registration/bindings/go/client.go counterparty-gateway/v1/registration/openapi.yaml
	@oapi-codegen -package registration -generate gin-server -o counterparty-gateway/v1/registration/bindings/go/server.go counterparty-gateway/v1/registration/openapi.yaml
	@cd counterparty-gateway/v1/registration/bindings/go && go mod tidy
	@# --- counterparty-gateway/webhook (oapi-codegen) ---
	@oapi-codegen -package webhook -generate types -o counterparty-gateway/v1/webhook/bindings/go/types.go counterparty-gateway/v1/webhook/openapi.yaml
	@oapi-codegen -package webhook -generate client -response-type-suffix "HTTPResponse" -o counterparty-gateway/v1/webhook/bindings/go/client.go counterparty-gateway/v1/webhook/openapi.yaml
	@oapi-codegen -package webhook -generate gin-server -o counterparty-gateway/v1/webhook/bindings/go/server.go counterparty-gateway/v1/webhook/openapi.yaml
	@cd counterparty-gateway/v1/webhook/bindings/go && go mod tidy
	@# --- wallet-orch (oapi-codegen) ---
	@oapi-codegen -package walletorch -generate types -o wallet-orch/v1/bindings/go/types.go wallet-orch/v1/openapi.yaml
	@oapi-codegen -package walletorch -generate client -response-type-suffix "HTTPResponse" -o wallet-orch/v1/bindings/go/client.go wallet-orch/v1/openapi.yaml
	@oapi-codegen -package walletorch -generate gin-server -o wallet-orch/v1/bindings/go/server.go wallet-orch/v1/openapi.yaml
	@cd wallet-orch/v1/bindings/go && go mod tidy
	@# --- error + fulfillment-confirmation (go-jsonschema; deterministic types only) ---
	@cd error/v1 && go-jsonschema -p atumerror -o bindings/go/types.go schema.json
	@cd fulfillment-confirmation/v1 && go-jsonschema -p fulfillmentconfirmation -o bindings/go/types.go schema.json
	@cd fulfillment-confirmation/v1/bindings/go && go mod tidy
	@# --- x402 atum-escrow scheme (Go: extra + payload + request subpackages) ---
	@$(MAKE) generate-x402-go
	@echo "✅ Deterministic Go API bindings generated"

init-veri-fill-go-module:
	@mkdir -p veri-fill/v1/bindings/go
	@if [ ! -f veri-fill/v1/bindings/go/go.mod ]; then \
		printf '%s\n' \
			'module github.com/atum-labs/protocol/schemas/apis/veri-fill/v1/bindings/go' \
			'' \
			'go 1.25.0' \
			'' \
			'require (' \
			' github.com/gin-gonic/gin v1.10.1' \
			' github.com/oapi-codegen/runtime v1.4.1' \
			' filippo.io/edwards25519 v1.2.0' \
			' github.com/decred/dcrd/dcrec/secp256k1/v4 v4.4.1' \
			' golang.org/x/crypto v0.55.0' \
			' golang.org/x/net v0.58.0' \
			' google.golang.org/protobuf v1.36.12' \
			')' \
			> veri-fill/v1/bindings/go/go.mod; \
	fi

# Generate Veri-Fill API bindings
generate-veri-fill: init-veri-fill-go-module
	@echo "Generating Veri-Fill API bindings..."
	@# Ensure directory exists
	@mkdir -p veri-fill/v1/bindings/go/generated
	@# Generate Go types (shared between client and server)
	@oapi-codegen -package generated \
		-generate types \
		-o veri-fill/v1/bindings/go/generated/types.go \
		veri-fill/v1/openapi.yaml
	@# Generate Go client (without types, with HTTP response suffix)
	@oapi-codegen -package generated \
		-generate client \
		-response-type-suffix "HTTPResponse" \
		-o veri-fill/v1/bindings/go/generated/client.go \
		veri-fill/v1/openapi.yaml
	@# Generate Go server interfaces (without types)
	@oapi-codegen -package generated \
		-generate gin-server \
		-o veri-fill/v1/bindings/go/generated/server.go \
		veri-fill/v1/openapi.yaml
	@# Clean up dependencies
	@cd veri-fill/v1/bindings/go && go mod tidy
	@# Generate TypeScript types
	@cd veri-fill/v1 && \
		pnpm exec openapi-typescript openapi.yaml -o bindings/typescript/src/types.ts
	@# Generate TypeScript client and types using @hey-api/openapi-ts
	@$(MAKE) generate-veri-fill-ts-client
	@echo "✅ Veri-Fill API bindings generated"

