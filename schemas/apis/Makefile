generate-fulfillment-confirmation: init-fulfillment-confirmation-go-module
	@echo "Generating Fulfillment Confirmation bindings..."
	@# Generate Go types from JSON Schema
	@cd fulfillment-confirmation/v1 && \
		go-jsonschema -p fulfillmentconfirmation -o bindings/go/types.go schema.json
	@# Clean up dependencies
	@cd fulfillment-confirmation/v1/bindings/go && go mod tidy
	@# Generate TypeScript types from JSON Schema (using workspace tools)
	@echo "Generating TypeScript bindings..."
	@cd fulfillment-confirmation/v1 && \
		pnpm exec json2ts schema.json > bindings/typescript/src/types.ts
	@echo "✅ Fulfillment Confirmation bindings generated"

# Generate Error bindings
generate-error:
	@echo "Generating Error bindings..."
	@# Generate Go types from JSON Schema
	@cd error/v1 && \
		go-jsonschema -p atumerror -o bindings/go/types.go schema.json
	@# Generate TypeScript types from JSON Schema (using workspace tools)
	@echo "Generating TypeScript bindings..."
	@cd error/v1 && \
		pnpm exec json2ts schema.json > bindings/typescript/src/types.ts
	@$(MAKE) mirror-error-catalog
	@echo "✅ Error bindings generated"

# Mirror the canonical catalog into a generated data file per binding (go:embed
# cannot escape its package dir, and the TS package cannot import JSON across dirs).
mirror-error-catalog:
	@echo "Mirroring error catalog into bindings..."
	@# The Go mirror is a raw string literal, which cannot hold a backtick. Fail
	@# here instead of emitting a catalog_data.go that will not compile.
	@if grep -q '`' error/v1/catalog.json; then \
		echo "✗ error/v1/catalog.json contains a backtick, which the Go raw-string catalog constant cannot hold. Remove it."; \
		exit 1; \
	fi
	@printf '// Code generated from apis/error/v1/catalog.json by make generate-error. DO NOT EDIT.\npackage atumerror\n\nconst catalogJSON = `' > error/v1/bindings/go/catalog_data.go
	@cat error/v1/catalog.json >> error/v1/bindings/go/catalog_data.go
	@printf '`\n' >> error/v1/bindings/go/catalog_data.go
	@printf '// Code generated from apis/error/v1/catalog.json by make generate-error. DO NOT EDIT.\nexport const catalog = ' > error/v1/bindings/typescript/src/catalog_data.ts
	@cat error/v1/catalog.json >> error/v1/bindings/typescript/src/catalog_data.ts
	@printf ';\n' >> error/v1/bindings/typescript/src/catalog_data.ts
	@# Generate the closed code set (Go constants + TS union) from the catalog keys.
	@node error/v1/gen-codes.js
	@gofmt -w error/v1/bindings/go/codes.go

# Drift guard: regenerate the mirrors and fail if they differ from what is
# committed. Reports untracked files as drift until the first commit.
check-error-catalog: mirror-error-catalog
	@echo "Checking error catalog mirrors are up to date..."
	@if [ -n "$$(git status --porcelain error/v1/bindings/go/catalog_data.go error/v1/bindings/typescript/src/catalog_data.ts error/v1/bindings/go/codes.go error/v1/bindings/typescript/src/codes.ts)" ]; then \
		echo "✗ Error catalog mirrors are stale. Run 'make generate-error' in schemas/apis and commit the result."; \
		git status --porcelain error/v1/bindings/go/catalog_data.go error/v1/bindings/typescript/src/catalog_data.ts error/v1/bindings/go/codes.go error/v1/bindings/typescript/src/codes.ts; \
		exit 1; \
	fi
	@echo "✅ Error catalog mirrors up to date"

