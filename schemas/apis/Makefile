init-payment-gateway-go-module:
	@mkdir -p payment-gateway/v1/bindings/go
	@if [ ! -f payment-gateway/v1/bindings/go/go.mod ]; then \
		printf '%s\n' \
			'module github.com/atum-labs/protocol/schemas/apis/payment-gateway/v1/bindings/go' \
			'' \
			'go 1.25.0' \
			'' \
			'require (' \
			' github.com/gin-gonic/gin v1.9.1' \
			' github.com/oapi-codegen/runtime v1.1.1' \
			' github.com/atum-labs/protocol/schemas/apis/error/v1/bindings/go v0.1.2' \
			' golang.org/x/crypto v0.52.0' \
			' golang.org/x/net v0.55.0' \
			' google.golang.org/protobuf v1.33.0' \
			')' \
			'' \
			'replace github.com/atum-labs/protocol/schemas/apis/error/v1/bindings/go => ../../../../error/v1/bindings/go' \
			> payment-gateway/v1/bindings/go/go.mod; \
	fi

# Generate Payment Gateway API bindings
# generate-payment-gateway: generate-payment-gateway-openapi
generate-payment-gateway: init-payment-gateway-go-module
	@echo "Generating Payment Gateway API bindings..."
	@# Generate Go types (shared between client and server)
	@oapi-codegen -package paymentgateway \
		-generate types \
		-o payment-gateway/v1/bindings/go/types.go \
		payment-gateway/v1/openapi.yaml
	@# Generate Go client (without types, with HTTP response suffix)
	@oapi-codegen -package paymentgateway \
		-generate client \
		-response-type-suffix "HTTPResponse" \
		-o payment-gateway/v1/bindings/go/client.go \
		payment-gateway/v1/openapi.yaml
	@# Generate Go server interfaces (without types)
	@oapi-codegen -package paymentgateway \
		-generate gin-server \
		-o payment-gateway/v1/bindings/go/server.go \
		payment-gateway/v1/openapi.yaml
	@# Generate OpenAPI spec embedding in separate embed directory (clean architecture)
	@mkdir -p payment-gateway/v1/embed/go
	@# Create embed module if it doesn't exist
	@if [ ! -f payment-gateway/v1/embed/go/go.mod ]; then \
		echo "module github.com/atum-labs/protocol/schemas/apis/payment-gateway/v1/embed/go" > payment-gateway/v1/embed/go/go.mod; \
		echo "" >> payment-gateway/v1/embed/go/go.mod; \
		echo "go 1.24" >> payment-gateway/v1/embed/go/go.mod; \
		echo "" >> payment-gateway/v1/embed/go/go.mod; \
		echo "toolchain go1.24.11" >> payment-gateway/v1/embed/go/go.mod; \
	fi
	@# Copy OpenAPI spec to embed directory to work with Go's embed limitations
	@cp payment-gateway/v1/openapi.yaml payment-gateway/v1/embed/go/openapi.yaml
	@echo "// Code generated by schemas/apis/Makefile. DO NOT EDIT." > payment-gateway/v1/embed/go/openapi.go
	@echo "" >> payment-gateway/v1/embed/go/openapi.go
	@echo "// Package embed provides the embedded OpenAPI specification for the Payment Gateway API." >> payment-gateway/v1/embed/go/openapi.go
	@echo "// This package is separate from the generated bindings to maintain clean architectural boundaries." >> payment-gateway/v1/embed/go/openapi.go
	@echo "// The OpenAPI spec is embedded directly from the source to ensure types and documentation" >> payment-gateway/v1/embed/go/openapi.go
	@echo "// are always synchronized." >> payment-gateway/v1/embed/go/openapi.go
	@echo "package embed" >> payment-gateway/v1/embed/go/openapi.go
	@echo "" >> payment-gateway/v1/embed/go/openapi.go
	@echo "import (" >> payment-gateway/v1/embed/go/openapi.go
	@echo "	_ \"embed\"" >> payment-gateway/v1/embed/go/openapi.go
	@echo ")" >> payment-gateway/v1/embed/go/openapi.go
	@echo "" >> payment-gateway/v1/embed/go/openapi.go
	@echo "// OpenAPISpec contains the embedded OpenAPI specification for the Payment Gateway API." >> payment-gateway/v1/embed/go/openapi.go
	@echo "// This ensures that the API documentation always matches the generated types." >> payment-gateway/v1/embed/go/openapi.go
	@echo "//" >> payment-gateway/v1/embed/go/openapi.go
	@echo "//go:embed openapi.yaml" >> payment-gateway/v1/embed/go/openapi.go
	@echo "var OpenAPISpec []byte" >> payment-gateway/v1/embed/go/openapi.go
	@# Clean up dependencies
	@cd payment-gateway/v1/bindings/go && go mod tidy
	@# TypeScript client for this API lives in payment-gateway/v1/bindings/typescript/client.
	@echo "✅ Payment Gateway API bindings generated"

# Create the auth Go module file only when it is missing. Rewriting an existing one from
# scratch would drop every dependency version raised on purpose since, such as a
# security fix, so a re-run would not reproduce the committed file.
init-auth-go-module:
	@mkdir -p auth/v1/bindings/go
	@if [ ! -f auth/v1/bindings/go/go.mod ]; then \
		printf '%s\n' \
			'module github.com/atum-labs/protocol/schemas/apis/auth/v1/bindings/go' \
			'' \
			'go 1.25.0' \
			'' \
			'require github.com/atum-labs/protocol/schemas/declarations/PaymentRequest/v1/bindings/go v0.0.0' \
			'' \
			'replace github.com/atum-labs/protocol/schemas/declarations/PaymentRequest/v1/bindings/go => ../../../../../declarations/PaymentRequest/v1/bindings/go' \
			> auth/v1/bindings/go/go.mod; \
	fi

# Pin gin and the oapi-codegen runtime on every run, so the `go mod tidy` that follows
# cannot float them to the latest release. The generated client needs the runtime to encode
# the form body of POST /v1/auth/token. Downstream services consume these bindings through
# a local replace directive and pin these lines themselves (atum-core runs gin v1.10.1, and
# its payment-gw resolves runtime v1.4.1), so a floated bump is a breaking change that
# forces every consumer to upgrade in lockstep. Raise a pin here and in the consumers
# together. generate-go-bindings runs this too, so a bump made only in go.mod fails the
# check-api-bindings drift guard instead of being reverted by the next generate-auth.
# tests/test-maintained-go-modules.sh asserts these versions; raise them there too.
pin-auth-go-module: init-auth-go-module
	@cd auth/v1/bindings/go && go mod edit \
		-require=github.com/gin-gonic/gin@v1.10.1 \
		-require=github.com/oapi-codegen/runtime@v1.4.1

# Generate Auth Service API bindings
generate-auth: pin-auth-go-module
	@echo "Generating Auth Service API bindings..."
	@# Generate Go types (shared between client and server)
	@oapi-codegen -package auth \
		-generate types \
		-o auth/v1/bindings/go/types.go \
		auth/v1/openapi.yaml
	@# Generate Go client (without types, with HTTP response suffix)
	@oapi-codegen -package auth \
		-generate client \
		-response-type-suffix "HTTPResponse" \
		-o auth/v1/bindings/go/client.go \
		auth/v1/openapi.yaml
	@# Generate Go server interfaces (without types)
	@oapi-codegen -package auth \
		-generate gin-server \
		-o auth/v1/bindings/go/server.go \
		auth/v1/openapi.yaml
	@# Clean up dependencies
	@cd auth/v1/bindings/go && go mod tidy
	@echo "✅ Auth Service API bindings generated"

