# Generate TypeScript client implementation
generate-veri-fill-ts-client:
	@echo "Generating Veri-Fill TypeScript client..."
	@mkdir -p veri-fill/v1/bindings/typescript/src
	@cd veri-fill/v1 && \
		../../../../node_modules/.bin/openapi-ts \
			--input ./openapi.yaml \
			--output ./bindings/typescript/src \
			--client axios \
			--name VeriFillClient \
			--useOptions

# Generate Wallet Orchestration API bindings (Go bindings + hey-api TS client)
generate-wallet-orch:
	@echo "Generating Wallet-Orch API bindings..."
	@mkdir -p wallet-orch/v1/bindings/go
	@# go.mod is pre-generated and checked in
	@oapi-codegen -package walletorch -generate types -o wallet-orch/v1/bindings/go/types.go wallet-orch/v1/openapi.yaml
	@oapi-codegen -package walletorch -generate client -response-type-suffix "HTTPResponse" -o wallet-orch/v1/bindings/go/client.go wallet-orch/v1/openapi.yaml
	@oapi-codegen -package walletorch -generate gin-server -o wallet-orch/v1/bindings/go/server.go wallet-orch/v1/openapi.yaml
	@cd wallet-orch/v1/bindings/go && go mod tidy
	@$(MAKE) generate-wallet-orch-ts-client
	@echo "✅ Wallet-Orch API bindings generated"

# Generate TypeScript client for wallet-orch via @hey-api/openapi-ts (unpinned; not in deps)
generate-wallet-orch-ts-client:
	@echo "Generating Wallet-Orch TypeScript client..."
	@mkdir -p wallet-orch/v1/bindings/typescript/src
	@cd wallet-orch/v1 && \
		../../../../node_modules/.bin/openapi-ts \
			--input ./openapi.yaml \
			--output ./bindings/typescript/src \
			--client axios \
			--name WalletOrchClient \
			--useOptions

init-x402-go-module:
	@mkdir -p x402/v1/bindings/go
	@if [ ! -f x402/v1/bindings/go/go.mod ]; then \
		printf '%s\n' \
			'module github.com/atum-labs/protocol/schemas/apis/x402/v1/bindings/go' \
			'' \
			'go 1.24' \
			'' \
			'toolchain go1.24.11' \
			'' \
			'require github.com/go-viper/mapstructure/v2 v2.5.0' \
			> x402/v1/bindings/go/go.mod; \
	fi

# x402 atum-escrow scheme Go bindings (extra + payload + request subpackages). Its own
# target so generate-x402 and the top-level generate-go-bindings drift guard share one
# recipe instead of duplicating the go.mod + go-jsonschema block.
generate-x402-go: init-x402-go-module
	@cd x402/v1 && go-jsonschema -p extra -o bindings/go/extra/types.go extra/schema.json
	@cd x402/v1 && go-jsonschema -p payload -o bindings/go/payload/types.go payload/schema.json
	@cd x402/v1 && go-jsonschema -p request --schema-root-type=file://apis/x402/v1/request/schema.json=AtumEscrowRequest -o bindings/go/request/types.go request/schema.json
	@cd x402/v1/bindings/go && go mod tidy

# Generate x402 atum-escrow scheme bindings. The scheme's Go + TypeScript types (extra +
# payload + request) live at x402/v1/bindings/, since the scheme's types span all three
# sub-schemas and are consumed as one package (@atum-labs/atum-escrow). The facilitator
# OpenAPI types are separate (a different generator) and stay under facilitator/.
generate-x402:
	@echo "Generating x402 bindings..."
	@# Go types for the scheme bindings (extra + payload + request subpackages)
	@$(MAKE) generate-x402-go
	@# TypeScript types (extra + payload + request → the @atum-labs/atum-escrow package src)
	@mkdir -p x402/v1/bindings/typescript/src
	@cd x402/v1/extra && pnpm exec json2ts schema.json > ../bindings/typescript/src/extra.ts
	@cd x402/v1/payload && pnpm exec json2ts schema.json > ../bindings/typescript/src/payload.ts
	@# request $ref's ../extra/schema.json; json2ts resolves $ref relative to CWD, so run from request/
	@cd x402/v1/request && pnpm exec json2ts schema.json > ../bindings/typescript/src/request.ts
	@# Facilitator OpenAPI types (separate generator; not part of the scheme package)
	@mkdir -p x402/v1/facilitator/bindings/typescript/src
	@cd x402/v1/facilitator && pnpm exec openapi-typescript openapi.yaml -o bindings/typescript/src/types.ts
	@echo "✅ x402 bindings generated"

