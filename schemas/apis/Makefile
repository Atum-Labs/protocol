# Lint - verify bindings are up to date
lint: lint-fulfillment-confirmation lint-veri-fill lint-payment-gateway lint-wallet-orch lint-counterparty-gateway-registration lint-counterparty-gateway-webhook lint-x402 check-error-catalog
	@echo "✅ All API bindings are up to date"

# Check if Wallet-Orch bindings are up to date. generate-wallet-orch regenerates
# both the Go bindings and the hey-api TypeScript client, so both are guarded here;
# the Go bindings are additionally covered by the top-level check-api-bindings, which
# does not cover the TypeScript client.
lint-wallet-orch: check-tools
	@echo "Checking if Wallet-Orch bindings are up to date..."
	@# Save current bindings
	@cp wallet-orch/v1/bindings/go/types.go wallet-orch/v1/bindings/go/types.go.bak 2>/dev/null || true
	@cp wallet-orch/v1/bindings/go/client.go wallet-orch/v1/bindings/go/client.go.bak 2>/dev/null || true
	@cp wallet-orch/v1/bindings/go/server.go wallet-orch/v1/bindings/go/server.go.bak 2>/dev/null || true
	@cp wallet-orch/v1/bindings/typescript/src/types.gen.ts wallet-orch/v1/bindings/typescript/src/types.gen.ts.bak 2>/dev/null || true
	@cp wallet-orch/v1/bindings/typescript/src/services.gen.ts wallet-orch/v1/bindings/typescript/src/services.gen.ts.bak 2>/dev/null || true
	@# Regenerate bindings
	@$(MAKE) generate-wallet-orch
	@# Check for differences in Go bindings
	@if [ -f wallet-orch/v1/bindings/go/types.go.bak ]; then \
		if ! diff -q wallet-orch/v1/bindings/go/types.go.bak wallet-orch/v1/bindings/go/types.go > /dev/null 2>&1; then \
			echo "❌ Go bindings are out of date!"; \
			echo "Run 'make generate' in schemas/apis/ to update bindings"; \
			mv wallet-orch/v1/bindings/go/types.go.bak wallet-orch/v1/bindings/go/types.go; \
			mv wallet-orch/v1/bindings/go/client.go.bak wallet-orch/v1/bindings/go/client.go 2>/dev/null || true; \
			mv wallet-orch/v1/bindings/go/server.go.bak wallet-orch/v1/bindings/go/server.go 2>/dev/null || true; \
			mv wallet-orch/v1/bindings/typescript/src/types.gen.ts.bak wallet-orch/v1/bindings/typescript/src/types.gen.ts 2>/dev/null || true; \
			mv wallet-orch/v1/bindings/typescript/src/services.gen.ts.bak wallet-orch/v1/bindings/typescript/src/services.gen.ts 2>/dev/null || true; \
			exit 1; \
		fi; \
	fi
	@# Check for differences in TypeScript bindings
	@if [ -f wallet-orch/v1/bindings/typescript/src/types.gen.ts.bak ]; then \
		if ! diff -q wallet-orch/v1/bindings/typescript/src/types.gen.ts.bak wallet-orch/v1/bindings/typescript/src/types.gen.ts > /dev/null 2>&1; then \
			echo "❌ TypeScript bindings are out of date!"; \
			echo "Run 'make generate' in schemas/apis/ to update bindings"; \
			mv wallet-orch/v1/bindings/go/types.go.bak wallet-orch/v1/bindings/go/types.go 2>/dev/null || true; \
			mv wallet-orch/v1/bindings/go/client.go.bak wallet-orch/v1/bindings/go/client.go 2>/dev/null || true; \
			mv wallet-orch/v1/bindings/go/server.go.bak wallet-orch/v1/bindings/go/server.go 2>/dev/null || true; \
			mv wallet-orch/v1/bindings/typescript/src/types.gen.ts.bak wallet-orch/v1/bindings/typescript/src/types.gen.ts; \
			mv wallet-orch/v1/bindings/typescript/src/services.gen.ts.bak wallet-orch/v1/bindings/typescript/src/services.gen.ts 2>/dev/null || true; \
			exit 1; \
		fi; \
	fi
	@# Clean up backup files
	@rm -f wallet-orch/v1/bindings/go/*.bak wallet-orch/v1/bindings/typescript/src/*.bak
	@echo "✅ Wallet-Orch bindings are up to date"

# Check if x402 atum-escrow scheme bindings (Go + TS: extra, payload, request) plus the
# facilitator OpenAPI types are up to date. Regenerates, then fails if any tracked binding
# changed OR a brand-new (untracked) binding file was emitted — the `git ls-files --others`
# check closes the gap where a plain `git diff` misses a newly-added file. Uses the working
# tree vs index, so it stays green on already-staged regen output. On drift it leaves the
# regenerated files in place (inspect the diff, then `make generate-x402` and commit). The
# scheme's Go bindings are additionally covered by the top-level check-api-bindings.
lint-x402: check-tools
	@echo "Checking if x402 bindings are up to date..."
	@$(MAKE) generate-x402 >/dev/null
	@paths='x402/v1/bindings/go x402/v1/bindings/typescript/src x402/v1/facilitator/bindings/typescript/src'; \
	if ! git diff --quiet -- $$paths || [ -n "$$(git ls-files --others --exclude-standard -- $$paths)" ]; then \
		echo "❌ x402 bindings are out of date!"; \
		echo "Run 'make generate-x402' in schemas/apis/ and commit the result."; \
		git --no-pager diff --stat -- $$paths; \
		git ls-files --others --exclude-standard -- $$paths | sed 's/^/  (untracked) /'; \
		exit 1; \
	fi
	@echo "✅ x402 bindings are up to date"

# Check if Veri-Fill bindings are up to date
