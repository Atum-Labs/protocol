			mv veri-fill/v1/bindings/go/generated/server.go.bak veri-fill/v1/bindings/go/generated/server.go 2>/dev/null || true; \
			mv veri-fill/v1/bindings/typescript/src/types.ts.bak veri-fill/v1/bindings/typescript/src/types.ts; \
			mv veri-fill/v1/bindings/typescript/src/client.ts.bak veri-fill/v1/bindings/typescript/src/client.ts 2>/dev/null || true; \
			exit 1; \
		fi; \
	fi
	@# Clean up backup files
