# Clean generated files
clean:
	@echo "Cleaning generated files..."
	@rm -rf veri-fill/v1/bindings/go/generated
	@rm -f veri-fill/v1/bindings/typescript/src/types.ts veri-fill/v1/bindings/typescript/src/client.ts veri-fill/v1/bindings/typescript/src/index.ts
	@rm -rf veri-fill/v1/bindings/typescript/dist
	@rm -rf veri-fill/v1/bindings/typescript/node_modules
	@# go.mod and go.sum are maintained, not generated: deleting them would
	@# re-seed the module from init-payment-gateway-go-module's fixed versions.
	@rm -f payment-gateway/v1/bindings/go/types.go payment-gateway/v1/bindings/go/client.go payment-gateway/v1/bindings/go/server.go
	@rm -rf payment-gateway/v1/embed/
	@# payment-gateway/v1/openapi.yaml is the hand-maintained spec the generators read.
	@rm -f payment-gateway/v1/go.mod payment-gateway/v1/go.sum
	@# fulfillment-confirmation's go.mod is maintained like the others above.
	@rm -f fulfillment-confirmation/v1/bindings/go/types.go
	@rm -f fulfillment-confirmation/v1/bindings/typescript/src/types.ts fulfillment-confirmation/v1/bindings/typescript/src/index.ts
	@rm -rf fulfillment-confirmation/v1/bindings/typescript/dist
	@rm -rf fulfillment-confirmation/v1/bindings/typescript/node_modules
	@echo "✅ Generated files cleaned"