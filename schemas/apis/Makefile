# Check if Counterparty Gateway Registration bindings are up to date
lint-counterparty-gateway-registration: check-tools
	@echo "Checking if Counterparty Gateway Registration bindings are up to date..."
	@# Save current bindings
	@cp counterparty-gateway/v1/registration/bindings/go/types.go counterparty-gateway/v1/registration/bindings/go/types.go.bak 2>/dev/null || true
	@cp counterparty-gateway/v1/registration/bindings/go/client.go counterparty-gateway/v1/registration/bindings/go/client.go.bak 2>/dev/null || true
	@cp counterparty-gateway/v1/registration/bindings/go/server.go counterparty-gateway/v1/registration/bindings/go/server.go.bak 2>/dev/null || true
	@cp counterparty-gateway/v1/registration/bindings/go/go.mod counterparty-gateway/v1/registration/bindings/go/go.mod.bak 2>/dev/null || true
	@# Regenerate bindings
	@$(MAKE) generate-counterparty-gateway-registration
	@# Check for differences
	@if [ -f counterparty-gateway/v1/registration/bindings/go/types.go.bak ]; then \
		if ! diff -q counterparty-gateway/v1/registration/bindings/go/types.go.bak counterparty-gateway/v1/registration/bindings/go/types.go > /dev/null 2>&1; then \
			echo "❌ Counterparty Gateway Registration bindings are out of date!"; \
			echo "Run 'make generate' in schemas/apis/ to update bindings"; \
			mv counterparty-gateway/v1/registration/bindings/go/types.go.bak counterparty-gateway/v1/registration/bindings/go/types.go; \
			mv counterparty-gateway/v1/registration/bindings/go/client.go.bak counterparty-gateway/v1/registration/bindings/go/client.go 2>/dev/null || true; \
			mv counterparty-gateway/v1/registration/bindings/go/server.go.bak counterparty-gateway/v1/registration/bindings/go/server.go 2>/dev/null || true; \
			mv counterparty-gateway/v1/registration/bindings/go/go.mod.bak counterparty-gateway/v1/registration/bindings/go/go.mod 2>/dev/null || true; \
			exit 1; \
		fi; \
	fi
	@# Clean up backup files
	@rm -f counterparty-gateway/v1/registration/bindings/go/*.bak
	@echo "✅ Counterparty Gateway Registration bindings are up to date"

# Check if Counterparty Gateway Webhook bindings are up to date
