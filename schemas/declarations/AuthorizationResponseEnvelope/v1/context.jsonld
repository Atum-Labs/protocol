{
  "$comment": "VP-envelope design applied to the auth_response path. Note on `verifiableCredential` (below): `@container: @graph` makes each VC its own RDF graph. URDNA2015 normalizes graphs order-independently AND deduplicates by node id — so (a) reordering the verifiableCredential array yields the same VP signature, and (b) identical-id VCs collapse to a single graph. This is the standard W3C VC array shape, byte-identical to PaymentRequestEnvelope/v1's and FulfillmentQuoteEnvelope/v1's context. MVP policy doesn't depend on order (`RequiredVCTypes` is set-based, `IsIssuerTrusted` is a per-VC predicate). If a future policy needs ordered VCs, swap `@graph` for `@list` here AND in the design doc — the order-dependent shape is a different canonicalization contract.",
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "atum": "https://schemas.atum.network/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sec": "https://w3id.org/security#",
    "dc": "http://purl.org/dc/terms/",
    "cred": "https://www.w3.org/2018/credentials#",

    "AuthorizationResponseEnvelope": {
      "@id": "atum:AuthorizationResponseEnvelope",
      "@type": "@id"
    },

    "VerifiablePresentation": {
      "@id": "cred:VerifiablePresentation",
      "@type": "@id"
    },

    "VerifiableCredential": {
      "@id": "cred:VerifiableCredential",
      "@type": "@id"
    },

    "version": {
      "@id": "atum:version",
      "@type": "xsd:string"
    },

    "holder": {
      "@id": "cred:holder",
      "@type": "@id"
    },

    "verifiableCredential": {
      "@id": "cred:verifiableCredential",
      "@type": "@id",
      "@container": "@graph"
    },

    "proof": {
      "@id": "sec:proof",
      "@type": "@id",
      "@container": "@graph"
    },

    "jws": {
      "@id": "sec:jws"
    },
    "proofValue": {
      "@id": "sec:proofValue"
    },
    "proofPurpose": {
      "@id": "sec:proofPurpose",
      "@type": "@vocab"
    },
    "verificationMethod": {
      "@id": "sec:verificationMethod",
      "@type": "@id"
    },
    "created": {
      "@id": "dc:created",
      "@type": "xsd:dateTime"
    },

    "challenge": {
      "@id": "sec:challenge"
    },
    "domain": {
      "@id": "sec:domain"
    },

    "authentication": {
      "@id": "sec:authentication",
      "@type": "@id"
    },
    "assertionMethod": {
      "@id": "sec:assertionMethod",
      "@type": "@id"
    }
  }
}
