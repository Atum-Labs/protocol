{
  "$comment": "Every declared field maps to its own IRI as an xsd:string literal, so two fields cannot swap without changing the content hash. Defines no proof, credential or presentation terms: the declaration is never signed directly, only attested by a BidDeclineEnvelope.",
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "atum": "https://schemas.atum.network/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "BidDecline": {
      "@id": "atum:BidDecline",
      "@type": "@id"
    },

    "payment_id": {
      "@id": "atum:paymentId",
      "@type": "xsd:string"
    },

    "quote_request_id": {
      "@id": "atum:quoteRequestId",
      "@type": "xsd:string"
    },

    "reason_code": {
      "@id": "atum:declineReasonCode",
      "@type": "xsd:string"
    },

    "message": {
      "@id": "atum:declineMessage",
      "@type": "xsd:string"
    },

    "issued_at": {
      "@id": "atum:issuedAt",
      "@type": "xsd:string"
    }
  }
}
