{
  "$comment": "Same terms as AuthorizationResponseEnvelope/v1's context apart from the envelope type term. `verifiableCredential` uses `@container: @graph`, so each VC is its own RDF graph and URDNA2015 normalizes them order-independently. The SettlementResult declaration itself defines no proof or presentation terms; they live only here.",
  "@context": {
    "@version": 1.1,
    "@protected": true,

    "atum": "https://schemas.atum.network/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sec": "https://w3id.org/security#",
    "dc": "http://purl.org/dc/terms/",
    "cred": "https://www.w3.org/2018/credentials#",

    "SettlementResultEnvelope": {
      "@id": "atum:SettlementResultEnvelope",
      "@type": "@id"
    },

    "VerifiablePresentation": {
      "@id": "cred:VerifiablePresentation",
      "@type": "@id"
    },

    "VerifiableCredential": {
      "@id": "cred:VerifiableCredential",
      "@type": "@id"
    },

    "version": {
      "@id": "atum:version",
      "@type": "xsd:string"
    },

    "holder": {
      "@id": "cred:holder",
      "@type": "@id"
    },

    "verifiableCredential": {
      "@id": "cred:verifiableCredential",
      "@type": "@id",
      "@container": "@graph"
    },

    "proof": {
      "@id": "sec:proof",
      "@type": "@id",
      "@container": "@graph"
    },

    "jws": {
      "@id": "sec:jws"
    },
    "proofValue": {
      "@id": "sec:proofValue"
    },
    "proofPurpose": {
      "@id": "sec:proofPurpose",
      "@type": "@vocab"
    },
    "verificationMethod": {
      "@id": "sec:verificationMethod",
      "@type": "@id"
    },
    "created": {
      "@id": "dc:created",
      "@type": "xsd:dateTime"
    },

    "challenge": {
      "@id": "sec:challenge"
    },
    "domain": {
      "@id": "sec:domain"
    },

    "authentication": {
      "@id": "sec:authentication",
      "@type": "@id"
    },
    "assertionMethod": {
      "@id": "sec:assertionMethod",
      "@type": "@id"
    }
  }
}
