{
  "name": "@atum-labs/payment-request-token-approval",
  "private": true,
  "version": "1.0.0",
  "description": "Permit2 source-token approval for PaymentRequest payers (EVM / Tron; not applicable on Solana).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
