{
  "name": "tvm-contracts",
  "version": "0.0.1",
  "description": "TVM contracts for Atum Labs",
  "main": "index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "tronbox test",
    "tronbox": "tronbox",
    "compile": "tronbox compile",
    "migrate": "tronbox migrate",
    "migrate:shasta": "tronbox migrate --network shasta",
    "migrate:nile": "tronbox migrate --network nile",
    "migrate:mainnet": "tronbox migrate --network mainnet",
    "migrate:development": "tronbox migrate --network development",
    "migrate:development:reset": "tronbox migrate --reset --network development",
    "deploy:local": "node scripts/deploy-local.js",
    "test:tronbox": "./scripts/run-tronbox-tests.sh",
    "test:no-compile": "tronbox test --no-compile",
    "test:scripts": "node --test scripts/deploy-local/*.test.js",
    "console": "tronbox console",
    "console:shasta": "tronbox console --network shasta",
    "console:nile": "tronbox console --network nile",
    "version": "tronbox version",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:test": "eslint test/**/*.js",
    "lint:migrations": "eslint migrations/**/*.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "9.31.0",
    "globals": "^16.3.0",
    "tronbox": "^4.2.0"
  },
  "dependencies": {
    "@alexroan/permit2-tron": "^0.0.5",
    "@openzeppelin/contracts": "5.3.0",
    "dotenv": "^17.2.1",
    "solmate": "^6.8.0",
    "tronweb": "^6.0.4"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": ">=0.16.8 <0.17",
      "@openzeppelin/contracts@<5": "4.9.6",
      "adm-zip@<0.6.0": ">=0.6.0",
      "ajv@<6.14.0": ">=6.14.0 <7",
      "axios@<1.18.0": ">=1.18.0",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "diff@>=5.0.0 <5.2.2": ">=5.2.2 <6",
      "flatted@<3.4.2": ">=3.4.2",
      "follow-redirects@<1.16.2": ">=1.16.2 <2",
      "form-data@<2.5.6": ">=2.5.6 <3",
      "form-data@>=3.0.0 <3.0.5": ">=3.0.5 <4",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "lodash@<4.18.0": ">=4.18.0",
      "minimatch@<3.1.4": ">=3.1.4 <4",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8 <6",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "picomatch@<2.3.2": ">=2.3.2 <3",
      "qs@<6.16.1": ">=6.16.1 <7",
      "serialize-javascript@<7.1.3": ">=7.1.3 <8",
      "tmp@<0.2.6": ">=0.2.6",
      "tough-cookie@<4.1.3": ">=4.1.3 <5",
      "validator@<13.15.22": ">=13.15.22",
      "ws": ">=8.21.0"
