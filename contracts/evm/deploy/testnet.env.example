# EVM deployment environment — TESTNET. The pins below are the LIBRARY GENERATION (CORE-3048, CORE-3055).
#
#   set -a; . contracts/evm/deploy/testnet.env; set +a
#
# This file is the TEMPLATE. Copy it to testnet.env, which is gitignored, and edit the copy:
#   cp contracts/evm/deploy/testnet.env.example contracts/evm/deploy/testnet.env
# Every driver reads $NETWORK.env, not this file.
#
# Every script here reads these via `: "${VAR:=default}"`, so exporting wins. run-all.sh sources
# this file automatically; point ENVF elsewhere to use your own.

# --- source of truth -------------------------------------------------------
# SRC_DIR defaults to ../source relative to each script, so leave it unless you build elsewhere.
: "${PROTOCOL_REF:=main}"; export PROTOCOL_REF
# The commit the library generation is built from (protocol#267, CORE-3048). run-all.sh phase 1 requires the
# checkout's HEAD to equal it, so on any later commit with the same contract sources run
# `export SRC_SHA=$(git rev-parse HEAD)` first.
: "${SRC_SHA:=fc31241074585bafa7eafd2f89f94fdc0b805c08}"; export SRC_SHA

# --- identity --------------------------------------------------------------
export ACCOUNT=atum-deployer-testnet      # forge keystore name; the drivers fix it by network (see import-deployer.sh)
: "${DEPLOYER:=0x11121EECf186b5365C3E65A7B16BfD231eAC76B5}"; export DEPLOYER
: "${SENDER:="$DEPLOYER"}"; export SENDER                     # the atum-core token-config driver reads this

# --- fixed chain constants -------------------------------------------------
# SALT and PERMIT2_ADDRESS are MIRRORS. The authority is whatever generates your services'
# environment. If these two ever disagree with it, it wins and the addresses below are wrong:
# the deployer is inside the initcode, so salt and constructor args both move the CREATE2
# address.
: "${SALT:=0x22b4280b956c7f0613b6313bbd60cf38e78fdbd98dee9876ee5db5fb1e7e4367}"; export SALT
: "${PERMIT2_ADDRESS:=0x000000000022D473030F116dDEE9F6B43aC78BA3}"; export PERMIT2_ADDRESS
: "${FACTORY:=0x4e59b44847b379578588920ca78fbf26c0b4956c}"; export FACTORY
# This file pins the library generation (EscrowReserveLib linked into the Escrow). Which chains have it is
# recorded in contracts/evm/deployments-v5.json, not here. The other testnets still run the v4 escrow and the
# v4 FulfillmentProxy, which main can no longer build, so to check or redeploy v4, export all of this first
# (CHAINS empty lifts the default below, and ESCROW matters beyond the deploy drivers: atum-core's
# token-config.sh takes the escrow it configures from here):
# ce01e304 has no contracts/evm/deploy, so run these scripts from this tree and point SRC_DIR at the contracts/evm/source
# of a built ce01e304 checkout (HEAD ce01e304, `pnpm install --ignore-workspace`, `forge build`):
#   export SRC_DIR=<built ce01e304 checkout>/contracts/evm/source \
#     SRC_SHA=ce01e304e788816c02f94e75be38add29bfe422f ESCROW_BYTES=23890 DEPLOY_PROXY=1 CHAINS= \
#     ESCROW=0x0F875601504C9179562506AFa34b2D084268869b \
#     ESCROW_INITCODE_HASH=0xe8afbb92f8a2c9192ffb25033c5553f4ba42e2fc3103598a3e1044e1fa5ee572
# (ESCROW_LIB is ignored in a tree with no src/EscrowReserveLib.sol.) ESCROW_BYTES counts the creation
# bytecode WITHOUT constructor arguments: 25,996 here, 26,060 with them; the runtime is 24,537 B.
: "${ESCROW_BYTES:=25996}"; export ESCROW_BYTES

# --- scope -------------------------------------------------------------------
# The default scope is Tempo Moderato only, so that a run on these defaults cannot touch a chain whose escrow
# is still v4: deploy.sh, funding-check.sh, run-all.sh and atum-core's token-config.sh all honour CHAINS.
# `${CHAINS=42431}` (no colon) assigns only when CHAINS is unset, so an exported empty value stays empty, which is how you say "every chain in CHAIN_TABLE".
# DEPLOY_PROXY=0 reuses the chain's live FulfillmentProxy: main's proxy is not the v4 one (it derives to
# 0xd1254EF0f2bc75AD577FE48fC5CC9c3ec13B0144 with these salts, not FPROXY), so deploying "both" would add
# a second, unpinned proxy.
: "${CHAINS=42431}"; export CHAINS
: "${DEPLOY_PROXY:=0}"; export DEPLOY_PROXY

# --- derived addresses (verified: reproduced from SRC_SHA + DEPLOYER + SALT) -
# derive-guard.sh + run-all.sh phase 6 re-derive these. run-all.sh refuses to broadcast after any failed phase;
# deploy.sh, run on its own, checks only the EXPECT_ESCROW / EXPECT_LIB / EXPECT_SALT pins you export.
# The escrow's address depends on the library's, which is inside its initcode (README, "The escrow library").
# FPROXY is the v4 proxy, reused by the library generation (DEPLOY_PROXY=0).
: "${ESCROW:=0x2db35C05D04F8bB21C602735C4FA9eEc932c2536}"; export ESCROW
: "${FPROXY:=0x1F1F8FA642bc5F530ba37F1Db3a656E9eB8BaFeb}"; export FPROXY
: "${ESCROW_INITCODE_HASH:=0xb47546a2ed9f8392fd0e24855bbf06daa54f68128b5fdbc1d05828a9d667e612}"; export ESCROW_INITCODE_HASH
: "${FPROXY_INITCODE_HASH:=0x9efddf157169aa58f6c7dcf48fe82f508bcfb45056a4f78150e778817a97ee7e}"; export FPROXY_INITCODE_HASH

# EscrowReserveLib's CREATE2 address (same factory, same SALT, no constructor arguments, so the same on
# mainnet). Deployed BEFORE the escrow and linked into it. run-all.sh phase 6 checks it (deploy.sh checks
# EXPECT_LIB). Exporting it as ESCROW_RESERVE_LIB_ADDRESS as well makes the escrow scripts verify the link
# on a manual `forge script` run, not only under deploy.sh.
: "${ESCROW_LIB:=0x88090131EC8bdFA1759f6B0e27d5aEa307b8eBBf}"; export ESCROW_LIB
if [ -n "$ESCROW_LIB" ]; then export ESCROW_RESERVE_LIB_ADDRESS="$ESCROW_LIB"; fi

# --- roles (testnet: all to the deployer, matching v3 precedent) -----------
: "${ESCROW_PAUSER_ADDRESS:="$DEPLOYER"}"; export ESCROW_PAUSER_ADDRESS
: "${ESCROW_TREASURER_ADDRESS:="$DEPLOYER"}"; export ESCROW_TREASURER_ADDRESS
: "${ESCROW_TOKEN_CONFIG_ADDRESS:="$DEPLOYER"}"; export ESCROW_TOKEN_CONFIG_ADDRESS
: "${FP_PAUSER_ADDRESS:="$DEPLOYER"}"; export FP_PAUSER_ADDRESS
# MAINNET: override all four, and hand DEFAULT_ADMIN to the Safe. Note the deployed
# defaultAdminDelay is 1 second — raise it while the deployer still holds admin.

# --- fee policy (all scaled 1e6) -------------------------------------------
: "${FEE_PERCENTAGE:=20000}"; export FEE_PERCENTAGE                   # 0.02% = 2 bps
: "${MIN_FEE:=0}"; export MIN_FEE                              # no floor
: "${MAX_FEE:=250000000}"; export MAX_FEE                      # $250 cap. 0 would mean UNCAPPED.
: "${EXPECT_DECIMALS:=6}"; export EXPECT_DECIMALS                      # the cap is only correct for 6-decimal tokens

# --- funding sizing --------------------------------------------------------
: "${MARGIN:=3}"; export MARGIN
: "${ROLE_GAS:=240000}"; export ROLE_GAS

# --- RPCs: 9 active testnets. Set ALCHEMY_API_KEY in gitignored testnet.env, never in this file.
# The key ends up inside every Alchemy URL below and in CHAIN_TABLE, so never print or paste those:
# print the chain name or the host instead. An already-exported URL still wins. With no key, the
# public endpoints from README 4a are used.
: "${ALCHEMY_API_KEY:=}"; export ALCHEMY_API_KEY
if [ -n "$ALCHEMY_API_KEY" ]; then
  : "${ETH_SEPOLIA_RPC:=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export ETH_SEPOLIA_RPC     # 11155111
  : "${ARB_SEPOLIA_RPC:=https://arb-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export ARB_SEPOLIA_RPC          # 421614
  : "${BASE_SEPOLIA_RPC:=https://base-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export BASE_SEPOLIA_RPC       # 84532
  : "${CELO_SEPOLIA_RPC:=https://celo-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export CELO_SEPOLIA_RPC       # 11142220
  : "${AMOY_RPC:=https://polygon-amoy.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export AMOY_RPC                       # 80002
  : "${OP_SEPOLIA_RPC:=https://opt-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export OP_SEPOLIA_RPC             # 11155420
  : "${FUJI_RPC:=https://avax-fuji.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export FUJI_RPC                           # 43113
  : "${MODERATO_RPC:=https://tempo-moderato.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export MODERATO_RPC             # 42431
  : "${ARC_TESTNET_RPC:=https://arc-testnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}}"; export ARC_TESTNET_RPC           # 5042002
else
  # No key: the public endpoints from README 4a. They rate-limit, so use a key for a full broadcast run.
  : "${ETH_SEPOLIA_RPC:=https://ethereum-sepolia-rpc.publicnode.com}"; export ETH_SEPOLIA_RPC     # 11155111
  : "${ARB_SEPOLIA_RPC:=https://sepolia-rollup.arbitrum.io/rpc}"; export ARB_SEPOLIA_RPC          # 421614
  : "${BASE_SEPOLIA_RPC:=https://sepolia.base.org}"; export BASE_SEPOLIA_RPC                       # 84532
  : "${CELO_SEPOLIA_RPC:=https://forno.celo-sepolia.celo-testnet.org}"; export CELO_SEPOLIA_RPC    # 11142220
  : "${AMOY_RPC:=https://polygon-amoy-bor-rpc.publicnode.com}"; export AMOY_RPC                    # 80002
  : "${OP_SEPOLIA_RPC:=https://sepolia.optimism.io}"; export OP_SEPOLIA_RPC                        # 11155420
  : "${FUJI_RPC:=https://api.avax-test.network/ext/bc/C/rpc}"; export FUJI_RPC                     # 43113
  : "${MODERATO_RPC:=https://rpc.moderato.tempo.xyz}"; export MODERATO_RPC                         # 42431
  : "${ARC_TESTNET_RPC:=https://rpc.testnet.arc.io}"; export ARC_TESTNET_RPC                   # 5042002
fi
# For a real run replace these with private endpoints. Public RPCs rate-limit, and a throttled
# node partway through a multi-chain deploy loop is not a risk worth taking with real funds.

# --- the chain set the drivers iterate ------------------------------------
# Defined here rather than duplicated as a fallback inside each driver. Every driver reads this and
# refuses if it is unset, so there is exactly one place the testnet chain set lives, and no way for
# a driver to iterate a different one than its sibling.
export CHAIN_TABLE="
11155111|Ethereum Sepolia|$ETH_SEPOLIA_RPC
421614|Arbitrum Sepolia|$ARB_SEPOLIA_RPC
84532|Base Sepolia|$BASE_SEPOLIA_RPC
11142220|Celo Sepolia|$CELO_SEPOLIA_RPC
80002|Polygon Amoy|$AMOY_RPC
11155420|Optimism Sepolia|$OP_SEPOLIA_RPC
43113|Avalanche Fuji|$FUJI_RPC
42431|Tempo Moderato|$MODERATO_RPC
5042002|Arc Testnet|$ARC_TESTNET_RPC
"
