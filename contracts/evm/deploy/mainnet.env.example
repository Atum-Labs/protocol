# EVM deployment environment — MAINNET. The pins below are the LIBRARY GENERATION (CORE-3048, CORE-3055) as deployed
# on Tempo Mainnet (4217, CORE-3264). The other eight mainnets still run the v4 escrow: see the v4 block below.
#
#   NETWORK=mainnet contracts/evm/deploy/run-all.sh --check
#   set -a; . contracts/evm/deploy/mainnet.env; set +a     # to use the drivers directly
#
# PRE-AUDIT: the pins below are the fc312410 build, deployed while the security audit (CORE-3057) is still open, and it
# is a non-default escrow next to the v4 one (0x815d450F). The audited build derives different addresses and gets its
# own record, not these pins.
#
# This file is the TEMPLATE. Copy it to mainnet.env, which is gitignored, and edit the copy:
#   cp contracts/evm/deploy/mainnet.env.example contracts/evm/deploy/mainnet.env
# Every driver reads $NETWORK.env, not this file.
#
# Mirrors testnet.env. run-all.sh picks this file when NETWORK=mainnet; exporting any variable
# beforehand still wins.

# --- source of truth -------------------------------------------------------
: "${PROTOCOL_REF:=main}"; export PROTOCOL_REF
# The commit the library generation is built from (protocol#267, CORE-3048): the CREATE2 address is a function of
# the bytecode, so this is part of the deployment's identity. run-all.sh phase 1 requires the checkout's HEAD to
# equal it, so on any later commit with the same contract sources run `export SRC_SHA=$(git rev-parse HEAD)` first.
# Tempo Mainnet only: don't lift CHAINS for this build until the security audit (CORE-3057) closes. An exported
# empty SRC_SHA does not skip the check here: `:=` also replaces an empty value (CHAINS uses `=` on purpose).
: "${SRC_SHA:=fc31241074585bafa7eafd2f89f94fdc0b805c08}"; export SRC_SHA

# --- identity --------------------------------------------------------------
# NOT the testnet deployer. This is a different key, and because defaultAdmin is a constructor
# argument the addresses below differ from the testnet ones as a direct result. The drivers fix the keystore by
# network (atum-deployer-mainnet here, the one that produced the Tempo Mainnet deployment); run-all.sh phase 3 compares
# the keystore's address with DEPLOYER only on a terminal (reading it needs the password), and otherwise just reports
# that the keystore exists.
export ACCOUNT=atum-deployer-mainnet      # forge keystore name; the drivers fix it by network
: "${DEPLOYER:=0xf92f2F170C2f649AE8CF07A8a84c43C74d65fE5A}"; export DEPLOYER
: "${SENDER:="$DEPLOYER"}"; export SENDER   # the atum-core token-config driver reads this

# --- fixed chain constants -------------------------------------------------
# SALT and PERMIT2_ADDRESS are MIRRORS of whatever generates your services' environment. If
# they disagree, that generator wins and the derived addresses below are wrong.
#
# The salt is the testnet salt, and the Tempo Mainnet library generation (the pins below) was deployed with it
# (contracts/evm/deployments-v5.json). Confirm it against that generator before deploying anywhere else, and
# re-derive ESCROW, ESCROW_LIB and the initcode hashes if it changes. run-all.sh phase 6 refuses on a mismatch. That
# check passes for any chain on a source tree from main, so it does not make this pre-audit build safe to lift to
# another chain: see CHAINS below.
: "${SALT:=0x22b4280b956c7f0613b6313bbd60cf38e78fdbd98dee9876ee5db5fb1e7e4367}"; export SALT
: "${PERMIT2_ADDRESS:=0x000000000022D473030F116dDEE9F6B43aC78BA3}"; export PERMIT2_ADDRESS
: "${FACTORY:=0x4e59b44847b379578588920ca78fbf26c0b4956c}"; export FACTORY
# This file pins the library generation (EscrowReserveLib linked into the Escrow). Which chains have it is recorded in
# contracts/evm/deployments-v5.json, not here: so far Tempo Mainnet (4217) only. The other eight mainnets still run
# the v4 escrow and the v4 FulfillmentProxy, which main can no longer build, so to check or redeploy v4, export all of
# this first (CHAINS empty lifts the default below; the v4 proxy hash below is checked only when DEPLOY_PROXY=1).
# ce01e304 has no contracts/evm/deploy, so run these scripts from this tree and point SRC_DIR at the contracts/evm/source
# of a built ce01e304 checkout (HEAD ce01e304, `pnpm install --ignore-workspace`, `forge build`): from a checkout of
# main, phase 1 refuses (HEAD is not ce01e304) and phase 6 refuses (25,996 vs 23,890 bytes).
#   export SRC_DIR=<built ce01e304 checkout>/contracts/evm/source \
#     SRC_SHA=ce01e304e788816c02f94e75be38add29bfe422f ESCROW_BYTES=23890 DEPLOY_PROXY=1 CHAINS= \
#     ESCROW=0x815d450F443466d52D3c1fB7a57D74D463D1E6F0 \
#     ESCROW_INITCODE_HASH=0x9f6ba8a61f59bf79eda7d16e1271220f500f9ba3e31c7291a98bdce2ca26d404 \
#     FPROXY_INITCODE_HASH=0x54b9ffcf2dd2da95b630423621ccf8fbfadfced205532564e55ab0457c9d9932
# (ESCROW_LIB is ignored in a tree with no src/EscrowReserveLib.sol.) ESCROW_BYTES counts the creation bytecode WITHOUT constructor arguments: 25,996 here, 26,060 with them; the
# runtime is 24,537 B.
: "${ESCROW_BYTES:=25996}"; export ESCROW_BYTES

# --- scope -------------------------------------------------------------------
# Tempo Mainnet only for this pre-audit build: don't lift CHAINS until the security audit (CORE-3057) closes. The
# default scope also means a run on these defaults cannot touch a chain whose escrow is still v4: deploy.sh, funding-check.sh, run-all.sh and atum-core's token-config.sh all honour CHAINS.
# `${CHAINS=4217}` (no colon) assigns only when CHAINS is unset, so an exported empty value stays empty, which is how
# you say "every chain in CHAIN_TABLE".
# DEPLOY_PROXY=0 reuses the chain's live FulfillmentProxy: main's proxy is not the v4 one (it gained
# authorizeFulfillment). With these salts and DEPLOYER it derives to 0x1FaF7640110Fb09BaD288dBEf5B4f676b0eC1932, not
# FPROXY: that address is already live on 4217 and is recorded as FulfillmentProxyPreview in deployments-v4.json.
# DEPLOY_PROXY=1 would therefore target a proxy other than the one beside the escrow (0xA8F40Ed7).
: "${CHAINS=4217}"; export CHAINS
: "${DEPLOY_PROXY:=0}"; export DEPLOY_PROXY

# --- derived addresses -----------------------------------------------------
# Reproduced from the compiled initcode + DEPLOYER + SALT above, and deployed on Tempo Mainnet. The initcode hash
# differs from testnet's even though the bytecode is the same, because DEPLOYER is a constructor argument and
# constructor arguments are part of the initcode. The escrow's address depends on the library's, which is inside its
# initcode.
: "${ESCROW:=0xedaD6a9846c79A64449603e95F8c77fd5A46881b}"; export ESCROW
# FPROXY is the v4 proxy on Tempo Mainnet, reused by the library generation (DEPLOY_PROXY=0). The preview proxy
# 0x1FaF7640110Fb09BaD288dBEf5B4f676b0eC1932 is live beside it on 4217; deploy-fulfillment-proxy.sh deploys that proxy
# alone and its address is not pinned here.
: "${FPROXY:=0xA8F40Ed7437BCB6bF264832369e8364b80B06c83}"; export FPROXY
: "${ESCROW_INITCODE_HASH:=0xf1b5460aa1a5d469309a0f121dbb2704e3d35932940acd33a16293926cf8f130}"; export ESCROW_INITCODE_HASH
# The v4 proxy's initcode hash. Not checked while DEPLOY_PROXY=0 (main's proxy no longer derives to it).
: "${FPROXY_INITCODE_HASH:=0x54b9ffcf2dd2da95b630423621ccf8fbfadfced205532564e55ab0457c9d9932}"; export FPROXY_INITCODE_HASH

# EscrowReserveLib's CREATE2 address (same factory, same SALT, no constructor arguments, so the same as on testnet).
# Deployed BEFORE the escrow and linked into it; its initcode hash is
# 0x95c7b8ba109f5fa99ce4df543ef20decb79a264e4bc5765a4dd9f2d21913b33d.
# run-all.sh phase 6 checks it (deploy.sh checks EXPECT_LIB). Exporting it as ESCROW_RESERVE_LIB_ADDRESS as well makes the
# escrow scripts verify the link on a manual `forge script` run, not only under deploy.sh.
: "${ESCROW_LIB:=0x88090131EC8bdFA1759f6B0e27d5aEa307b8eBBf}"; export ESCROW_LIB
if [ -n "$ESCROW_LIB" ]; then export ESCROW_RESERVE_LIB_ADDRESS="$ESCROW_LIB"; fi

# --- roles -----------------------------------------------------------------
# These are the holders run-all.sh phase 9 checks with hasRole and the ones deploy.sh grants again when it finds a role
# missing (ROLES_INCOMPLETE), so on a chain that has an escrow they must be the holders it is meant to have. They
# follow the admin handover of the Tempo Mainnet escrow (the default scope): the Safe 0x85B8530e...Fbb36c holds
# TREASURER and TOKEN_CONFIG (the deployer holds them too until its copies are revoked, which these checks do not mind);
# PAUSER and DEFAULT_ADMIN are still the deployer, and the admin moves to the Safe separately. For a run that includes
# another chain, where the deployer should hold the roles first (atum-core's token-config driver runs as SENDER=DEPLOYER),
# export ESCROW_TREASURER_ADDRESS and ESCROW_TOKEN_CONFIG_ADDRESS=$DEPLOYER before it.
# defaultAdminDelay is 1 second from the constructor but it is not fixed: an increase to 172800 s (48 h) is pending on
# the Tempo Mainnet escrow. Read it from the chain (run-all.sh phase 9 prints it) rather than from here.
: "${ESCROW_PAUSER_ADDRESS:="$DEPLOYER"}"; export ESCROW_PAUSER_ADDRESS
: "${ESCROW_TREASURER_ADDRESS:=0x85B8530eAFbA1Cff05D64717fE7E6Ac1F6Fbb36c}"; export ESCROW_TREASURER_ADDRESS
: "${ESCROW_TOKEN_CONFIG_ADDRESS:=0x85B8530eAFbA1Cff05D64717fE7E6Ac1F6Fbb36c}"; export ESCROW_TOKEN_CONFIG_ADDRESS
: "${FP_PAUSER_ADDRESS:="$DEPLOYER"}"; export FP_PAUSER_ADDRESS

# --- fee policy (all scaled 1e6) -------------------------------------------
: "${FEE_PERCENTAGE:=20000}"; export FEE_PERCENTAGE
: "${MIN_FEE:=0}"; export MIN_FEE
: "${MAX_FEE:=250000000}"; export MAX_FEE                      # $250 cap. 0 would mean UNCAPPED.
: "${EXPECT_DECIMALS:=6}"; export EXPECT_DECIMALS

# --- funding sizing --------------------------------------------------------
: "${MARGIN:=3}"; export MARGIN
: "${ROLE_GAS:=240000}"; export ROLE_GAS

# --- RPCs: 9 mainnets. Public endpoints; replace with private ones for a real run.
: "${ETH_MAINNET_RPC:=https://ethereum-rpc.publicnode.com}"; export ETH_MAINNET_RPC    # 1
: "${ARB_ONE_RPC:=https://arb1.arbitrum.io/rpc}"; export ARB_ONE_RPC               # 42161
: "${BASE_MAINNET_RPC:=https://mainnet.base.org}"; export BASE_MAINNET_RPC              # 8453
: "${CELO_MAINNET_RPC:=https://forno.celo.org}"; export CELO_MAINNET_RPC                # 42220
: "${POLYGON_RPC:=https://polygon-bor-rpc.publicnode.com}"; export POLYGON_RPC     # 137
: "${OP_MAINNET_RPC:=https://mainnet.optimism.io}"; export OP_MAINNET_RPC             # 10
: "${AVAX_RPC:=https://api.avax.network/ext/bc/C/rpc}"; export AVAX_RPC         # 43114
# Tempo Mainnet. rpc.tempo.xyz is an alias for the same chain; one canonical name here.
# NOTE: Tempo charges gas in pathUSD, not a native coin -- see token_gas_meta() in
# funding-check.sh. `cast balance` on this chain returns a placeholder, not spendable gas.
: "${TEMPO_MAINNET_RPC:=https://rpc.mainnet.tempo.xyz}"; export TEMPO_MAINNET_RPC       # 4217
# Arc. Gas is USDC, the chain's native coin: `cast balance` is real spendable gas at 18 decimals, so the
# native path in funding-check.sh applies, not token_gas_meta().
: "${ARC_MAINNET_RPC:=https://rpc.mainnet.arc.io}"; export ARC_MAINNET_RPC              # 5042
# For a real run replace these with private endpoints. Public RPCs rate-limit, and a throttled
# node partway through a multi-chain deploy loop is not a risk worth taking with real funds.

# --- the chain set the drivers iterate ------------------------------------
# deploy.sh and funding-check.sh REQUIRE CHAIN_TABLE -- there is no longer a per-driver fallback.
# Each used to carry its own copy of the testnet chain set, four copies that had drifted to two
# different behaviours, so the fallback was removed and a missing CHAIN_TABLE now exits 2 with a
# message telling you to source this file (deploy.sh:85-90, funding-check.sh:118). Sourcing it is
# what stops a mainnet run validating the mainnet deployer and then iterating testnet chains.
export CHAIN_TABLE="
1|Ethereum|$ETH_MAINNET_RPC
42161|Arbitrum One|$ARB_ONE_RPC
8453|Base|$BASE_MAINNET_RPC
42220|Celo|$CELO_MAINNET_RPC
137|Polygon|$POLYGON_RPC
10|Optimism|$OP_MAINNET_RPC
43114|Avalanche|$AVAX_RPC
4217|Tempo Mainnet|$TEMPO_MAINNET_RPC
5042|Arc|$ARC_MAINNET_RPC
"
