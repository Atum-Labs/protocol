{
  "name": "@atum-labs/contract-registry",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript reader for the contract version registry (contracts/registry/chains)",
  "main": "dist/typescript/src/index.js",
  "types": "dist/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/typescript/src/index.d.ts",
      "default": "./dist/typescript/src/index.js"
    },
    "./overlay": {
      "types": "./dist/typescript/src/overlay.d.ts",
      "default": "./dist/typescript/src/overlay.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "overlay": [
        "dist/typescript/src/overlay.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0"
}
