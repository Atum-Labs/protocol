{
  "name": "@atum-labs/stellar-deploy-scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Deploy and smoke scripts for the Stellar (Soroban) escrow and fulfillment proxy. Executed against a local Protocol 30 network and Stellar testnet.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 src && prettier --check .",
    "lint:fix": "eslint --fix src && prettier --write .",
    "stellar-deploy": "tsx src/deploy.ts",
    "smoke": "tsx src/smoke-deposit-release.ts",
    "scenarios": "tsx src/smoke-scenarios.ts"
  },
  "dependencies": {
    "@atum-labs/stellar-escrow-encoding": "workspace:*",
    "@stellar/stellar-sdk": "17.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
