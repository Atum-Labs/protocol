   );
 
   const usdcAccount = await getOrCreateAssociatedTokenAccount(
@@ -748,6 +757,20 @@
   };
 }
 
+// Reads a Solana keypair JSON (64-byte secret-key array) from the file path in
+// the given env var. Returns undefined when the var is unset so callers fall
+// back to createMint's default (random) keypair.
+function readOptionalKeypairFromEnv(envName: string): Keypair | undefined {
+  const keypairPath = process.env[envName]?.trim();
+  if (!keypairPath) return undefined;
+  const keyData = JSON.parse(fs.readFileSync(keypairPath, "utf-8"));
+  const keypair = Keypair.fromSecretKey(Uint8Array.from(keyData));
+  console.log(
+    `Using fixed mint keypair from ${envName}: ${keypair.publicKey.toBase58()}`
+  );
+  return keypair;
+}
