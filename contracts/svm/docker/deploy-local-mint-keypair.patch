# Deterministic mint keypairs for local development.
#
# Makes solana-escrow/scripts/deploy-local.ts accept committed mint keypairs for
# the local USDC/USDT mints, gated behind LOCAL_USDC_MINT_KEYPAIR /
# LOCAL_USDT_MINT_KEYPAIR. Without a fixed keypair, spl-token createMint()
# generates a RANDOM mint address each run; every Atum service resolves the
# Solana USDC/USDT mint from STATIC config at startup, so the local mint address
# must be deterministic. When the env vars are unset the behavior is unchanged
# (random mint), so devnet/testnet deploys are untouched.
#
# Applied at Docker build time only (`patch -p1`); the committed solana-escrow
# submodule stays clean. FOLLOW-UP: upstream this env-gated tweak to
# solana-escrow so the patch can be dropped.
#
--- a/scripts/deploy-local.ts	2026-06-03 12:21:54
+++ b/scripts/deploy-local.ts	2026-06-03 12:22:23
@@ -687,12 +687,20 @@
 }> {
   console.log("\nDeploying SPL token mints...");
 
+  // Deterministic mint addresses for local development. createMint() defaults
+  // to a random keypair (6th arg); feeding a committed keypair pins the mint to
+  // a fixed address that static config (token registry, settler env) can target.
+  // Env-gated so devnet/testnet deploys (env unset) keep their random mints.
+  const usdcMintKeypair = readOptionalKeypairFromEnv("LOCAL_USDC_MINT_KEYPAIR");
+  const usdtMintKeypair = readOptionalKeypairFromEnv("LOCAL_USDT_MINT_KEYPAIR");
+
   const usdcMint = await createMint(
     connection,
