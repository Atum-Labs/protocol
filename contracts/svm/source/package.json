{
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint --fix . && prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "build": "anchor build",
    "test": "anchor test",
    "deploy:local": "ts-node scripts/deploy-local.ts",
    "deploy": "ts-node scripts/deploy.ts",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:fmt": "cargo fmt --all",
    "rust:fmt:check": "cargo fmt --all -- --check",
    "rust:compile": "cargo build-sbf",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:all": "pnpm run typecheck && pnpm run typecheck:scripts",
    "fixtures:real-mints": "ts-node scripts/refresh-real-mint-fixtures.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.2",
    "bs58": "^5.0.0",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/bn.js": "^5.1.0",
    "@types/chai": "^4.3.1",
    "@types/mocha": "^9.0.0",
    "chai": "^4.3.4",
    "eslint": "^9.36.0",
    "mocha": "^9.0.3",
    "prettier": "^2.6.2",
    "ts-mocha": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.44.1"
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node@<0.16.8": ">=0.16.8 <0.17",
      "ajv@<6.14.0": ">=6.14.0 <7",
      "bn.js@>=5.0.0 <5.2.3": ">=5.2.3",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "diff@>=5.0.0 <5.2.2": ">=5.2.2 <6",
      "flatted@<3.4.2": ">=3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "minimatch@<3.1.4": ">=3.1.4 <4",
      "minimatch@>=4.0.0 <4.2.5": ">=4.2.5 <5",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7 <10",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "picomatch@<2.3.2": ">=2.3.2 <3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "serialize-javascript@<7.1.3": ">=7.1.3 <8",
      "stream-json@<3.7.0": ">=3.7.0 <4",
      "toml@<5.0.1": ">=5.0.1 <6",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "ws": ">=8.21.0"
    }
  }
}
