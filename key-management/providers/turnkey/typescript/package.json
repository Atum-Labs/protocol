{
  "name": "@atum-labs/turnkey-signer",
  "version": "0.1.0",
  "description": "Turnkey-backed Signer for EVM/Solana/Stellar/Tron plus server-side policy admin tooling",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./evm": { "types": "./dist/chains/evm.d.ts", "default": "./dist/chains/evm.js" },
    "./solana": { "types": "./dist/chains/solana.d.ts", "default": "./dist/chains/solana.js" },
    "./stellar": { "types": "./dist/chains/stellar.d.ts", "default": "./dist/chains/stellar.js" },
    "./tron": { "types": "./dist/chains/tron.d.ts", "default": "./dist/chains/tron.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" },
    "./admin": { "types": "./dist/admin/index.d.ts", "default": "./dist/admin/index.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepare": "tsc",
    "prepublishOnly": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.scripts.json",
    "turnkey:create-sub-org": "tsx scripts/create-sub-organization.ts",
    "turnkey:delete-sub-org": "tsx scripts/delete-sub-organization.ts",
    "turnkey:create-api-key": "tsx scripts/create-api-key.ts",
    "turnkey:rotate-api-key": "tsx scripts/rotate-api-key.ts",
    "turnkey:approve-activity": "tsx scripts/approve-activity.ts",
    "turnkey:apply-policies": "tsx scripts/apply-policies.ts",
    "turnkey:list-policies": "tsx scripts/list-policies.ts",
    "turnkey:delete-policies": "tsx scripts/delete-policies.ts",
    "turnkey:test-policies": "tsx scripts/test-policies.ts"
  },
  "dependencies": {
    "@atum-labs/km-core": "workspace:*"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.91.0",
    "@stellar/stellar-sdk": ">=17.0.0",
    "bs58": "^6.0.0",
    "ethers": "^6.11.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": { "optional": true },
    "@stellar/stellar-sdk": { "optional": true },
    "bs58": { "optional": true },
    "ethers": { "optional": true }
  },
  "devDependencies": {
    "@atum-labs/payment-request-sender-auth": "workspace:*",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.91.0",
    "@stellar/stellar-sdk": "17.3.0",
    "@turnkey/crypto": "^2.3.1",
    "@types/node": "^20.11.0",
    "bs58": "^6.0.0",
    "ethers": "^6.11.0",
    "tronweb": "^6.0.0",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11",
    "yaml": "^2.5.1"
  },
  "files": ["dist", "src"],
  "license": "Apache-2.0"
}
