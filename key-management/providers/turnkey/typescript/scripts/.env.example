# Copy to `scripts/.env` (gitignored). Every script in this directory loads it automatically.
#
# ---------------------------------------------------------------------------
# Provisioning scripts — three SEPARATE credential sets, one per phase. Keep them distinct,
# never reuse one slot for another phase.

# 1) PARENT org root — used ONLY by create-sub-org.
TURNKEY_PARENT_ORG_ID=
TURNKEY_PARENT_API_PUBLIC_KEY=
TURNKEY_PARENT_API_PRIVATE_KEY=

# 2) SUB-ORG root user key (generated by create-sub-org) — used by create-api-key and apply-policies.
TURNKEY_SUBORG_ROOT_API_PUBLIC_KEY=
TURNKEY_SUBORG_ROOT_API_PRIVATE_KEY=

# 3) SUB-ORG non-root AGENT key (generated by create-api-key) — used ONLY by test-policies.
#    Must be non-root: root bypasses policies and would make every "expect DENY" case pass.
TURNKEY_SUBORG_USER_API_PUBLIC_KEY=
TURNKEY_SUBORG_USER_API_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Signing scripts (evm/, svm/, tvm/) — a wallet the sub-org already holds.
# Anything already exported in the shell wins over the value set here.

TURNKEY_ORGANIZATION_ID=
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=

# Wallet to sign with: set the id, or the address to discover the id from
# (`0x…` on EVM, base58 `T…` on Tron, base58 on Solana). An address given here
# is also pinned as the one the wallet must resolve to.
TURNKEY_WALLET_ID=
TURNKEY_WALLET_ADDRESS=

# Optional.
# TURNKEY_API_URL=https://api.turnkey.com
# TURNKEY_PINNED_ADDRESS=

# Chain endpoint to broadcast on, for every script: an ethers JSON-RPC url under evm/, a Solana
# JSON-RPC url under svm/, a Tron full-node HTTP base under tvm/. It selects the chain, so it is
# normally passed per command rather than parked here:
#   RPC_URL=https://arb1.arbitrum.io/rpc npx tsx scripts/evm/transfer.ts <to> 0.01
# Set it here only to default to one chain.
# RPC_URL=

# Per-script optional overrides.
# PERMIT2_ADDRESS=          # evm/approve-permit2, tvm/approve-permit2
# FEE_MANAGER_ADDRESS=      # evm/set-tempo-fee-token
# TRON_NETWORK=mainnet      # tvm/approve-permit2 — mainnet (default) or shasta
# FEE_LIMIT_SUN=100000000   # tvm/approve-permit2 — fee_limit in SUN
